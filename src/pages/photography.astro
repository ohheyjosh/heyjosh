---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import nyc1 from '../images/nyc1.jpg';
import chicago1 from '../images/chicago1.jpg';
import chicago2 from '../images/chicago2.jpg';
import chicago3 from '../images/chicago3.jpg';
import chicago4 from '../images/chicago4.jpg';
import chicago5 from '../images/chicago5.jpg';
import florida1 from '../images/florida1.jpg';
import florida2 from '../images/florida2.jpg';
import florida3 from '../images/florida3.jpg';
---

<Layout title="photography" description="photography by a person named josh">
  <main class="row-start-2">
    <ul role="list" class="flex flex-1 flex-col space-y-6 sm:px-16">
      <li class="w-full h-auto">
        <Picture src={nyc1} alt="NYC" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={chicago1} alt="Chicago" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={chicago2} alt="Chicago" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={chicago3} alt="Chicago" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={chicago4} alt="Chicago" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={chicago5} alt="Chicago" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={florida1} alt="Florida" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={florida2} alt="Florida" formats={['avif', 'webp']} />
      </li>
      <li class="w-full h-auto">
        <Picture src={florida3} alt="Florida" formats={['avif', 'webp']} />
      </li>
    </ul>
  </main>
</Layout>
